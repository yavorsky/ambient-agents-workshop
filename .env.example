# Copy to .env. Everything is optional; without keys the agent runs fully simulated.

# --- Decision models for the gate (System One API); see /decisions ---
TYPESAFE_API_KEY=                        # Jev
CLOUDFLARE_ACCOUNT_ID=                   # Clef / Clef-Flash on Workers AI
CLOUDFLARE_API_TOKEN=
DECISION_PROVIDER=clef                   # jev | clef | clef-flash (first configured one if unset); Clef was faster and more accurate than Flash in our tests
DECISION_THRESHOLD=0.6                   # below this confidence the gate asks the LLM; 0.6 settled 27 of 30 storm events, all right, with Clef

# --- Models: OpenRouter when set; otherwise Vercel AI Gateway ---
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
MODEL_GATE=anthropic/claude-haiku-4.5    # gate: every batch, cheap and fast
MODEL_WORKER=anthropic/claude-sonnet-5   # WORKER_MODE=model
GATE_MODE=                               # decision | model | rules (default: decision when a decision model is set, else model when an LLM key is set)

# --- Worker ---
WORKER_MODE=sim                          # sim | model (one structured call, no tools) | claude (`claude -p` with skills)
CLAUDE_MODEL=claude-sonnet-5-5           # claude mode only

# --- Live agent (main checkout only) ---
GITHUB_REPO=                             # owner/name to watch with the gh CLI
AGENT_LOGIN=ambient-agent                # GitHub login the agent posts as, so its own comments are filtered
SLACK_WEBHOOK_URL=                       # pings and the digest; printed to stdout when empty
SIM_SPEED=1                              # <1 makes simulated workers faster

# --- Live agent (pnpm live): real issues and PRs on the repo, answered by Claude Code ---
LIVE_REPO=yavorsky/ambient-agents-workshop
LIVE_GH_TOKEN=                           # fine-grained token for LIVE_REPO only: Issues + Pull requests read/write; Contents, Actions, Metadata read
LIVE_WORKER_MODE=claude                  # claude: replies and reviews on GitHub; model: decides and pings, posts nothing

# GitHub signals (step 2). How events arrive when GITHUB_REPO is set: poll (default, works anywhere) or webhook
# (GitHub, or `gh webhook forward`, POSTs to /webhooks/github). The secret signs deliveries; the agent checks it.
GITHUB_SOURCE=poll
GITHUB_WEBHOOK_SECRET=
